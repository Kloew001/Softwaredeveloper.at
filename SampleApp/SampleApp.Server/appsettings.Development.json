{
  "ConnectionStrings": {
    "DbContextConnection": "User ID=postgres;Password=admin;Server=localhost;Port=5432;Database=SampleApp;"
  },

  "AllowedOrigins": [
    "http://localhost:4200",
    "http://example.com"
  ],

  "HostedServices": {
    "EMailHostedService": {
      "Enabled": true,
      "ExecuteMode": "Trigger"
      //"ExecuteMode": "Interval"
    },
    "DataSeedHostedService": {
      "Enabled": true
    },
    "AsyncTaskExecutorHostedService": {
      "Enabled": true,
      "ExecuteMode": "Trigger"
      //"Interval": "500ms"
    },
    "MultilingualDataSeedHostedService": {
      "Enabled": true
    }
  },

  "Url": {
    "BaseUrl": "https://127.0.0.1:4200/"
  },

  "SmtpServer": {
    "FromName": "Development",
    "FromEmail": "development@softwaredeveloper.com",
    "UserName": "",
    "Password": "",
    "SmtpServer": "localhost",
    "Port": 25
  },

  "RateLimiting": {
    "Enabled": true,
    "Whitelist": [ "::1" ],
    "Blacklist": []
  },

  "SensitiveData": {
    "Enabled": true,
    "SensitiveKeywords": {
      "Field": [
        "employeeId",
        "salary"
      ],
      "Header": [
        "X-Company-Auth"
      ],
      "Cookie": [
        "myAppSession"
      ],
      "UrlSegment": [
        "resetCode"
      ]
    }
  },

  "Serilog": {
    "MinimumLevel": {
      "Override": {
        "SoftwaredeveloperDotAt.Infrastructure.Core.Utility.EfCommandInterceptor": "Warning"
      }
    }
  }

}
